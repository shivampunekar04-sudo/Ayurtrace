# AyurTrace credentials template.
# Copy this to `.env` in the folder you run from (apps/gateway for the gateway,
# complete-b for the SMS test), fill in real values, and DO NOT commit it — `.env`
# is gitignored. Everything works without these; setting them flips mocked → live.

# --- IPFS pinning (used by the gateway: POST /ipfs/pin, operator lab-cert upload) ---
# Get a JWT from https://pinata.cloud → API Keys → New Key (recommended).
PINATA_JWT=
# Optional alternative (legacy web3.storage token); used only if PINATA_JWT is empty.
WEB3_STORAGE_TOKEN=
# Optional: public gateway used to build resolvable URLs (default gateway.pinata.cloud).
# IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- Twilio SMS (used by complete-b: Tier-3 SMS + PoLK fan-out) ---
# From https://twilio.com/console → Account SID / Auth Token, and a purchased number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Recipient for `npm run sms:test` (your own phone, E.164 format, e.g. +9198XXXXXXXX).
TEST_SMS_TO=
